# MarketMind — Environment Variables
# Copy this file to .env and fill in values before running.

# ── Ollama ────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_KEEP_ALIVE=-1

# ── Database ──────────────────────────────────────────────────
DB_PATH=./db/marketmind.db

# ── RAG / ChromaDB ────────────────────────────────────────────
CHROMA_PATH=./rag/chroma_db

# ── Voice: STT (faster-whisper) ───────────────────────────────
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8

# ── Voice: TTS — YarnGPT ─────────────────────────────────────
YARNGPT_MODEL_DIR=./voice/models/yarngpt
WAVTOKENIZER_DIR=./voice/models/wavtokenizer

# ── Voice: TTS — Piper (Hausa) ────────────────────────────────
PIPER_HAUSA_MODEL=./voice/models/piper_hausa/ha_NE-rmtts-medium.onnx
PIPER_HAUSA_CONFIG=./voice/models/piper_hausa/ha_NE-rmtts-medium.onnx.json

# ── Server ────────────────────────────────────────────────────
PORT=8000
